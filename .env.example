# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- Mistral AI (required for grounded answers, interpretation, and reports) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Only needed if you use a custom/proxied Mistral-compatible endpoint.
MISTRAL_BASE_URL=

# The LLM provider used across the app. Mistral is the only supported/tested
# provider for this project.
DEFAULT_PROVIDER=mistral

# --- Local embeddings (no external server required) ---
# fastembed downloads this small ONNX model automatically on first use and
# then runs fully offline/in-process. No Ollama, no hosted embedding API.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- RAG / chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# --- Market data ---
# true  = use the bundled offline sample data under data/<TICKER>/ (works with no internet)
# false = fetch live data via yfinance
YAHOO_SERVICE_OFFLINE=true

# --- Storage (optional overrides; sensible defaults are used if left blank) ---
VECTOR_DB_DIR=
PUBLISHED_RESEARCH_DIR=
